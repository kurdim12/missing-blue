# Optional: live Claude calls for the AI council, AI triage, Ask Missing Blue and work orders.
# Without a key every AI screen plays a recorded run, labelled "Recorded run". Never commit your real key.
ANTHROPIC_API_KEY=
# Model (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
PORT=8787
# Optional: sends the anthropic-workspace-id header. Set it only if the API answers 400 without it.
# ANTHROPIC_WORKSPACE_ID=
# Optional: depth of Ask Missing Blue answers, low (default) or medium.
# ASSISTANT_EFFORT=low
