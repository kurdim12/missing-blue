{
  "name": "missing-blue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Missing Blue: NISAR radar wet spots checked against Karak's real pipe network, AI triage, hydraulic twin and HydroFingerprint",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "vite build && tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "fetch:pipes": "tsx scripts/fetch_pipes.ts",
    "convert:radar": "python scripts/convert_radar.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "maplibre-gl": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
