node_modules/
dist/
dist-*/
.env
*.log
# The raw pipe network is NOT redistributed (critical infrastructure, no licence stated).
# Fetch it locally with: npm run fetch:pipes  (layer 6 only, never the customers layer)
data/pipes/
# Raw rasters stay local; the app uses the PNG overlays in public/radar/ (converted by scripts/convert_radar.py)
data/radar/*.tif
data/elevation/*.tif
# Simulation training sets (large); regenerated by pipeline/hf_sim.py
data/hydrofingerprint/*.npz
# Held back until the owner confirms they may be public (they contain Mazar-zone pipe coordinates; the demo HTML embeds the same twin geometry)
data/twin/
data/hydrofingerprint/hydrofingerprint_results.json
data/hydrofingerprint/hf_live_model.json
data/hydrofingerprint/hf_gaps_pick.json
.qa-lock/
demo/missing-blue.html
